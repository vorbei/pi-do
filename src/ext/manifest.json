{
  "manifest_version": 3,
  "name": "Pi Browser Agent",
  "description": "A side-panel browser agent whose agent loop runs on Pi in a Cloudflare Durable Object.",
  "version": "0.0.0",
  "minimum_chrome_version": "125",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open Pi Browser Agent", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "debugger", "tabs", "storage"]
}
